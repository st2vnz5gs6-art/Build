# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, used by seed/demo scripts and API routes that
# need to write past row-level security (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Data feed — API-Football via RapidAPI (https://rapidapi.com/api-sports/api/api-football)
# Optional in Phase 1: demo mode works without this. Set it to pull real fixtures.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# Base URL used when generating absolute OG image URLs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
