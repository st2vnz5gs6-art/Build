# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Claude model and reasoning effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# auto = live if a key is set, otherwise offline search-only mode. Force with live / mock.
SA_LLM_MODE=auto

# Corporate proxy, if the laptop needs one to reach api.anthropic.com
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional Tesseract OCR for scanned drawings (otherwise Claude vision is used)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
